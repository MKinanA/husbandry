<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category Groups -->

    <record model="ir.module.category" id="module_category_husbandry_vendor">
        <field name="name">Husbandry Vendor</field>
        <field name="description">Helps you manage your husbandry vendor users.</field>
        <field name="sequence">14</field>
    </record>

    <record model="ir.module.category" id="module_category_husbandry_customer">
        <field name="name">Husbandry Customer</field>
        <field name="description">Helps you manage your husbandry customer users.</field>
        <field name="sequence">13</field>
    </record>



    <!-- Category Groups -->


    <!-- Group -->

    <record id="group_husbandry_vendor" model="res.groups">
        <field name="name">Husbandry Vendor</field>
        <field name="category_id" ref="husbandry_12.module_category_husbandry_vendor"/>
        <!-- <field name="users" eval="[(5,ref('base.user_root'))]"/> -->
        <field name="implied_ids" eval="[(4,ref('base.group_user'))]"/>
    </record>

    <record id="group_husbandry_customer" model="res.groups">
        <field name="name">Husbandry Customer</field>
        <field name="category_id" ref="husbandry_12.module_category_husbandry_customer"/>
        <!-- <field name="users" eval="[(5,ref('base.user_root'))]"/> -->
        <field name="implied_ids" eval="[(4,ref('base.group_user'))]"/>
    </record>

    <!-- Group -->


    <!-- Rule -->

    <record model="ir.rule" id="vendor_view_husbandry_livestock_rule">
        <field name="name">Vendor View Livestock</field>
        <field name="model_id" ref="husbandry_12.model_husbandry_livestock" />
        <field name="groups"
            eval="[(4, ref('husbandry_12.group_husbandry_vendor'))]" />
        <field name="domain_force"> [('vendor_id','=',user.partner_id.id)]</field>
    </record>

    <record model="ir.rule" id="customer_view_husbandry_livestock_rule">
        <field name="name">Customer View Livestock</field>
        <field name="model_id" ref="husbandry_12.model_husbandry_livestock" />
        <field name="groups"
            eval="[(4, ref('husbandry_12.group_husbandry_customer'))]" />
        <field name="domain_force"> [('state','not in', ['draft', 'cancel'])]</field>
    </record>

    <record model="ir.rule" id="customer_view_account_invoice_rule">
        <field name="name">Customer View Invoice</field>
        <field name="model_id" ref="account.model_account_invoice" />
        <field name="groups"
            eval="[(4, ref('husbandry_12.group_husbandry_customer'))]" />
        <field name="domain_force"> [('partner_id','=',user.partner_id.id)]</field>
    </record>

    <!--Rule -->

</odoo>