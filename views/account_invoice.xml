<odoo>
    <!-- Form View Override for Customers -->
    <record id="view_account_move_form_husbandry_customer" model="ir.ui.view">
        <field name="name">account.move.form.husbandry.customer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="groups_id" eval="[(4, ref('husbandry.group_husbandry_customer'))]" />
        <field name="arch" type="xml">
            <!-- Disable actions on the form -->
            <form create="false" edit="false" delete="false" copy="false"/>

            <!-- Replace header -->
            <xpath expr="//header" position="replace">
                <header>
                    <button name="preview_invoice" type="object" string="Preview"/>
                    <field name="state" widget="statusbar" nolabel="1" statusbar_visible="draft,open,paid"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- Tree View Override for Customers -->
    <record id="view_account_move_tree_husbandry_customer" model="ir.ui.view">
        <field name="name">account.move.tree.husbandry.customer</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree" />
        <field name="groups_id" eval="[(4, ref('husbandry.group_husbandry_customer'))]" />
        <field name="arch" type="xml">
            <!-- Disable actions on tree -->
            <tree create="false" copy="false" delete="false"/>
        </field>
    </record>
</odoo>
