<odoo>
    <record id="catalog_action" model="ir.actions.act_url">
        <field name="name">Catalog</field>
        <field name="url">/husbandry</field> <!-- Adjust this URL route -->
        <field name="target">self</field>
    </record>
    <record id="catalog_menu" model="ir.ui.menu">
        <field name="name">Catalog</field>
        <field name="parent_id" ref="husbandry_menu"/>
        <field name="action" ref="catalog_action"/>
    </record>
</odoo>