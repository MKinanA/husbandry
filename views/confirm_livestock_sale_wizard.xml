<odoo>
    <record id="confirm_livestock_sale_wizard_form" model="ir.ui.view">
        <field name="name">Confirm Sale</field>
        <field name="model">husbandry.livestock.sell.wizard</field>
        <field name="arch" type="xml">
        <form string="Confirm Sale">
            <p>Confirm sale of livestock to booker?</p>
            <p>Be sure to confirm booker's payment before proceeding.</p>
            <footer>
            <button name="submit" string="Confirm sale" type="object" class="btn-primary"/>
            <button string="Cancel" special="cancel"/>
            </footer>
        </form>
        </field>
    </record>

    <record id="action_open_confirm_livestock_sale_wizard" model="ir.actions.act_window">
        <field name="name">Sell Livestock</field>
        <field name="res_model">husbandry.livestock.sell.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'livestock_id': active_id}</field>
    </record>
</odoo>