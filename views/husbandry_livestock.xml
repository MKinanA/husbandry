<odoo>
    <!-- Form View -->
    <record id="view_husbandry_livestock_form" model="ir.ui.view">
        <field name="name">husbandry.livestock.form</field>
        <field name="model">husbandry.livestock</field>
        <field name="arch" type="xml">
            <form string="Livestock">
                <header>
                    <button name="create_invoice" string="Buy" type="object"
                            attrs="{'invisible': [('state', '!=', 'saleable')]}"/>
                    <button name="create_product" string="Make Saleable" type="object"
                            attrs="{'invisible': [('product_id', '!=', False)]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,saleable,soldout"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="reference"/>
                            <field name="weight"/>
                            <field name="origin"/>
                            <field name="product_id"
                                   attrs="{'invisible': [('product_id', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="create_date" string="Registration Date" readonly="1"/>
                            <field name="owner_ids" widget="many2many_tags"/>
                            <field name="vendor_id"/>
                            <field name="kelompok"/>
                            <field name="type_id"/>
                            <field name="jatah"/>
                            <field name="purchase_price" groups="base.group_erp_manager"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Images">
                            <group col="4">
                                <field name="image_front" widget="image" string="Image 1"/>
                                <field name="image_right" widget="image" string="Image 2"/>
                                <field name="image_left" widget="image" string="Image 3"/>
                                <field name="image_back" widget="image" string="Image 4"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_husbandry_livestock_tree" model="ir.ui.view">
        <field name="name">husbandry.livestock.tree</field>
        <field name="model">husbandry.livestock</field>
        <field name="arch" type="xml">
            <tree string="Livestock">
                <field name="name"/>
                <field name="weight" string="Berat"/>
                <field name="vendor_id"/>
                <field name="owner_ids" widget="many2many_tags"/>
                <field name="purchase_price"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_husbandry_livestock_kanban" model="ir.ui.view">
        <field name="name">husbandry.livestock.kanban</field>
        <field name="model">husbandry.livestock</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="weight"/>
                <field name="vendor_id"/>
                <field name="owner_ids"/>
                <field name="purchase_price"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings mt4">
                                    <strong class="o_kanban_record_title">
                                        <span><t t-esc="record.name.value"/></span>
                                    </strong>
                                </div>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'draft': 'default', 'cancel': 'muted', 'done': 'success'}}"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-default">
                                    <span><field name="vendor_id"/></span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span><t t-esc="record.weight.value"/> KG - Rp <t t-esc="record.purchase_price.value"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_husbandry_livestock_search" model="ir.ui.view">
        <field name="name">husbandry.livestock.search</field>
        <field name="model">husbandry.livestock</field>
        <field name="arch" type="xml">
            <search string="Livestock">
                <field name="name"/>
                <field name="create_date" string="Registration Date"/>
                <field name="reference"/>
                <field name="weight" string="Berat"/>
                <field name="kelompok"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_husbandry_livestock" model="ir.actions.act_window">
        <field name="name">Livestock</field>
        <field name="res_model">husbandry.livestock</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_husbandry_livestock"
              name="Livestock"
              parent="menu_husbandry_root"
              action="action_husbandry_livestock"/>
</odoo>
